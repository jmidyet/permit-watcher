# Copy this file to .env (same directory) and fill in your values.
# config_loader loads .env automatically from the project root.

# --- Telegram notifications ---
# 1. In Telegram, open a chat with @BotFather, send /newbot, follow the prompts,
#    and copy the HTTP API token it gives you.
# 2. Send your new bot any message (e.g. "hi") so it can see your chat.
# 3. Get your chat id:  python utils/get_telegram_chat_id.py
#    (or open https://api.telegram.org/bot<TOKEN>/getUpdates and find "chat":{"id":...})
TELEGRAM_BOT_TOKEN=123456789:AA-replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Email (optional, only if you flip notification.email: true in config.yaml) ---
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password

# --- SMS via Twilio (optional, only if notification.sms: true) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
